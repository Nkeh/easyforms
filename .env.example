# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (used by the db service; mirrored into DATABASE_URL below)
POSTGRES_DB=easyforms
POSTGRES_USER=easyforms
POSTGRES_PASSWORD=easyforms
DATABASE_URL=postgres://easyforms:easyforms@db:5432/easyforms

# Redis / RQ
REDIS_URL=redis://redis:6379/0

# Ingest privacy (CLAUDE.md rule 5 — HMAC key for hashing submitter IPs)
IP_HASH_SECRET=dev-insecure-ip-hash-secret-change-me

# Email (real provider TBD by Day 10; local dev uses the console backend)
DEFAULT_FROM_EMAIL=EasyForms <noreply@easyforms.example>

# Public base URL endpoint links (Form.endpoint_url, the /f/{token} snippet) are
# built from; always this value, never the incoming request's Host header.
PUBLIC_BASE_URL=http://localhost:8000

# Number of trusted reverse proxies (e.g. a load balancer) in front of the app.
# 0 = trust REMOTE_ADDR directly and ignore X-Forwarded-For entirely. N > 0 =
# take the Nth address from the right of X-Forwarded-For as the real client IP;
# any client-supplied entries beyond that position are never trusted.
TRUSTED_PROXY_COUNT=0

# Logging (NFR-10). Level for the app's stdout logger.
LOG_LEVEL=INFO

# Ingest request-size ceilings (FR-3.2, FR-3.6). A submission exceeding any
# of these is rejected with 413 payload_too_large before being stored.
INGEST_MAX_BODY_BYTES=65536
INGEST_MAX_FIELDS=50
INGEST_MAX_FIELD_CHARS=10000
INGEST_MAX_KEY_CHARS=100

# Ingest rate limits (FR-7.1). Per source-IP hash and per form token, each
# with a per-minute and a per-hour fixed-window cap. Breaching either
# returns 429 rate_limited with a Retry-After header.
INGEST_RATE_LIMIT_IP_PER_MINUTE=10
INGEST_RATE_LIMIT_IP_PER_HOUR=100
INGEST_RATE_LIMIT_TOKEN_PER_MINUTE=60
INGEST_RATE_LIMIT_TOKEN_PER_HOUR=1000

# Auth rate limits (SRS section 11 — credential-stuffing protection).
AUTH_RATE_LIMIT_LOGIN_IP_PER_MINUTE=10
AUTH_RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE=5
AUTH_RATE_LIMIT_SIGNUP_IP_PER_HOUR=5
AUTH_RATE_LIMIT_RESET_IP_PER_HOUR=5
AUTH_RATE_LIMIT_RESET_EMAIL_PER_HOUR=3

# Model artifact storage (Day 8, SRS section 7). 'local' stores under
# MODEL_ARTIFACT_DIR (a Docker named volume in compose); 's3' uses Cloudflare
# R2 via boto3's S3-compatible API.
ARTIFACT_STORAGE=local
MODEL_ARTIFACT_DIR=/var/lib/easyforms/artifacts
R2_ACCOUNT_ID=dummy-account-id
R2_ACCESS_KEY_ID=dummy-access-key-id
R2_SECRET_ACCESS_KEY=dummy-secret-access-key
R2_BUCKET=easyforms-dev

# Cache dir for the spam training corpus (Day 8, `train_spam_model`), a
# Docker named volume in compose.
SPAM_DATASET_DIR=/var/lib/easyforms/data

# Spam scoring (Day 9, SRS FR-4). How often the ingest process re-checks for a
# newly activated ModelVersion, and how the _ts timing heuristic (soft signal,
# CLAUDE.md rule 9) adjusts the model's effective threshold on a fast submission.
SPAM_MODEL_REFRESH_SECONDS=60
SPAM_MIN_SUBMIT_SECONDS=3
SPAM_FAST_SUBMIT_MARGIN=0.25
