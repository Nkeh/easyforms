# Production env template (Day 13a). Every value below must be a real,
# generated secret / real hostname before this goes anywhere near a live
# deploy — config/settings/prod.py fails to boot (ImproperlyConfigured) if
# SECRET_KEY, IP_HASH_SECRET, DATABASE_URL, REDIS_URL, or PUBLIC_BASE_URL
# still match their .env.example dev-insecure values, or if ALLOWED_HOSTS,
# ADMIN_URL, or CSRF_TRUSTED_ORIGINS are left unset.

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=example.com,www.example.com
# Must include the public https:// origin(s) Caddy terminates TLS for — the
# CSRF origin check compares against this, not ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=https://example.com
# Change from the default "admin/" — not a secret by itself, but a distinct
# path keeps the admin off casual/automated /admin/ scans.
ADMIN_URL=admin-a1b2c3/
# Applies once DNS + the redirect behavior are confirmed safe; HSTS is hard
# to fully undo for clients that already cached it. Seconds; 86400 = 1 day.
SECURE_HSTS_SECONDS=86400
# Both default False. Only set True deliberately, on a domain you own every
# subdomain of — PRELOAD in particular is submitted to browser vendors'
# preload lists and is effectively irreversible. See docs/runbook.md.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_SSL_REDIRECT=True

# Postgres (used by the db service; mirrored into DATABASE_URL below)
POSTGRES_DB=easyforms
POSTGRES_USER=easyforms
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
DATABASE_URL=postgres://easyforms:<POSTGRES_PASSWORD>@db:5432/easyforms

# Redis / RQ
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=0.3
REDIS_BREAKER_SECONDS=5

# Ingest privacy (CLAUDE.md rule 5 — HMAC key for hashing submitter IPs).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
IP_HASH_SECRET=

# Email (Day 10, FR-5). Pick one real provider — never "console"/"smtp" in
# production.
DEFAULT_FROM_EMAIL=EasyForms <noreply@example.com>
EMAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Public base URL — the real domain, always https.
PUBLIC_BASE_URL=https://example.com

# Caddy sits directly in front of web (one hop).
TRUSTED_PROXY_COUNT=1

# The domain Caddy requests a real ACME/Let's Encrypt cert for. Use
# "localhost" to test this compose file locally — Caddy then issues from its
# own internal CA instead of hitting a real CA.
DOMAIN=example.com

# Gunicorn worker count (~186MB/worker: Django + the in-process spam model).
WEB_CONCURRENCY=2

LOG_LEVEL=INFO

# Ingest request-size ceilings (FR-3.2, FR-3.6).
INGEST_MAX_BODY_BYTES=65536
INGEST_MAX_FIELDS=50
INGEST_MAX_FIELD_CHARS=10000
INGEST_MAX_KEY_CHARS=100

# Ingest rate limits (FR-7.1).
INGEST_RATE_LIMIT_IP_PER_MINUTE=10
INGEST_RATE_LIMIT_IP_PER_HOUR=100
INGEST_RATE_LIMIT_TOKEN_PER_MINUTE=60
INGEST_RATE_LIMIT_TOKEN_PER_HOUR=1000

# Auth rate limits (SRS section 11).
AUTH_RATE_LIMIT_LOGIN_IP_PER_MINUTE=10
AUTH_RATE_LIMIT_LOGIN_EMAIL_PER_MINUTE=5
AUTH_RATE_LIMIT_SIGNUP_IP_PER_HOUR=5
AUTH_RATE_LIMIT_RESET_IP_PER_HOUR=5
AUTH_RATE_LIMIT_RESET_EMAIL_PER_HOUR=3

# Model artifact storage (Day 8). R2 in production.
ARTIFACT_STORAGE=s3
MODEL_ARTIFACT_DIR=/var/lib/easyforms/artifacts
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=easyforms-prod

SPAM_DATASET_DIR=/var/lib/easyforms/data
SPAM_MODEL_REFRESH_SECONDS=60
SPAM_MIN_SUBMIT_SECONDS=3
SPAM_FAST_SUBMIT_MARGIN=0.25
SPAM_MODEL_MODE=auto
SPAM_FP_ALERT_RATE=0.02
SPAM_ALERT_MIN_ROWS=50

# Backup/restore (Day 13a). A distinct R2 access key from R2_ACCESS_KEY_ID
# above — a leaked artifact token must not be able to read/write backups.
# Set a 30-day lifecycle (expiry) rule on BACKUP_BUCKET in the Cloudflare
# dashboard; not implemented in code (see docs/runbook.md).
BACKUP_STORAGE=s3
BACKUP_LOCAL_DIR=/var/lib/easyforms/backups
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_BUCKET=easyforms-backups-prod

# Sentry (NFR-10). Leave SENTRY_DSN blank to disable entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=production
